{
	"name": "@twin.org/playground",
	"version": "0.0.0",
	"description": "Playground applications demonstrating the capabilities of the ecosystem framework.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iotaledger/twin-playground.git"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"private": true,
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"build": "node ./scripts/workspaces.mjs build",
		"dist": "node ./scripts/workspaces.mjs dist",
		"dist:no-test": "node ./scripts/workspaces.mjs dist:no-test",
		"test": "node ./scripts/workspaces.mjs test",
		"format": "prettier --config prettier.config.mjs --write .",
		"lint:format": "prettier --config prettier.config.mjs --check .",
		"lint:code": "eslint . --cache --cache-location .eslintcache",
		"lint:markdown": "markdownlint **/*.md --ignore **/node_modules/** --ignore **/docs/reference/**  --ignore **/changelog.md --ignore **/test-results/**",
		"lint:spell": "cspell ** --no-progress",
		"lint": "npm run lint:format && npm run lint:code && npm run lint:markdown && npm run lint:spell",
		"docs": "node ./scripts/workspaces.mjs docs",
		"local-link": "node ./scripts/local-link.mjs",
		"commitlint": "commitlint --edit",
		"generate-release-configs": "node scripts/generate-release-configs.mjs release",
		"prepare": "husky"
	},
	"devDependencies": {
		"@commitlint/cli": "20.5.0",
		"@commitlint/config-conventional": "20.5.0",
		"@eslint/eslintrc": "3.3.5",
		"@eslint/js": "9.39.1",
		"@stylistic/eslint-plugin": "5.10.0",
		"@typescript-eslint/eslint-plugin": "8.57.1",
		"@typescript-eslint/parser": "8.57.1",
		"cspell": "9.7.0",
		"eslint": "9.39.1",
		"eslint-config-prettier": "10.1.8",
		"@tony.ganchev/eslint-plugin-header": "3.4.4",
		"eslint-plugin-import-x": "4.16.2",
		"eslint-plugin-jsdoc": "62.8.1",
		"eslint-plugin-prettier": "5.5.5",
		"eslint-plugin-promise": "7.2.1",
		"eslint-plugin-simple-import-sort": "12.1.1",
		"eslint-plugin-svelte": "3.16.0",
		"eslint-plugin-unicorn": "63.0.0",
		"eslint-plugin-unused-imports": "4.4.1",
		"globals": "17.4.0",
		"husky": "9.1.7",
		"markdownlint-cli": "0.48.0",
		"prettier": "3.8.1",
		"prettier-plugin-svelte": "3.5.1",
		"prettier-plugin-tailwindcss": "0.7.2",
		"release-please": "17.9.0"
	},
	"workspaces": [
		"apps/playground-node",
		"apps/playground-ui"
	],
	"type": "module",
	"bugs": {
		"url": "git+https://github.com/iotaledger/twin-playground/issues"
	},
	"homepage": "https://twindev.org"
}
