{
	"name": "@twin.org/playground-ui",
	"version": "0.0.3-next.1",
	"description": "A web interface built with Svelte that provides interactive access to the playground REST API endpoints.",
	"private": true,
	"scripts": {
		"clean": "rimraf .svelte-kit test-results",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "npm run test:integration && npm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:integration": "playwright test",
		"test:unit": "vitest --run",
		"merge-locales": "merge-locales --config ./merge-locales-config.json",
		"docs:clean": "echo Nothing to clean",
		"docs": "npm run docs:clean",
		"dist": "npm run clean && npm run build && npm run check && npm run merge-locales && npm run test",
		"postinstall": "npx playwright install"
	},
	"dependencies": {
		"@twin.org/api-auth-entity-storage-rest-client": "next",
		"@twin.org/api-models": "next",
		"@twin.org/api-rest-client": "next",
