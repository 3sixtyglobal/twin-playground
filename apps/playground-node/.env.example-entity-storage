#----------------------------- Connector Types -----------------------------#

# Entity Storage

## Entity Storage can be a comma separated list [file, memory, aws-dynamodb, azure-cosmosdb, gcp-firestoredb, scylladb, postgresql, mysql, mongodb, synchronised]
PLAYGROUND_ENTITY_STORAGE_CONNECTOR_TYPE="file"

## Entity Storage Connector default connector, defaults to the first connector in the list
# PLAYGROUND_ENTITY_STORAGE_CONNECTOR_DEFAULT=""

## Entity Storage connector to use for which has the synchronisation feature
# PLAYGROUND_ENTITY_STORAGE_CONNECTOR_SYNCHRONISED=""

## Prefix to add to tables in entity storage to separate the data from instances e.g. playground-node-
# PLAYGROUND_ENTITY_STORAGE_TABLE_PREFIX=""

# Blob Storage

## Blob Storage can be a comma separated list [memory, file, ipfs, aws-s3, azure-storage, gcp-storage]
PLAYGROUND_BLOB_STORAGE_CONNECTOR_TYPE="file"

## Blob Storage Connector default connector, defaults to the first connector in the list
# PLAYGROUND_BLOB_STORAGE_CONNECTOR_DEFAULT=""

## Blob Storage connector to use when it requires public access, e.g. for synchronised storage
# PLAYGROUND_BLOB_STORAGE_CONNECTOR_PUBLIC=""

## Prefix to add to directories in blob storage
# PLAYGROUND_BLOB_STORAGE_PREFIX=""

## Enable encryption for blob storage, this will encrypt the data before storing it
PLAYGROUND_BLOB_STORAGE_ENABLE_ENCRYPTION=true

## The key id to use in the vault for encryption
# PLAYGROUND_BLOB_STORAGE_ENCRYPTION_KEY_ID="blob-encryption"

## The symmetric encryption key to use for blob storage, should be ChaCha20Poly1305 in base64 format
## If encryption is enabled but a key is not provided one will be generated.
# PLAYGROUND_BLOB_STORAGE_SYMMETRIC_ENCRYPTION_KEY=""

# Logging Connector

## Logging Connector [console,entity-storage]
## You can log to more than one connector my separating them with a comma
PLAYGROUND_LOGGING_CONNECTOR="console,entity-storage"

# Vault Connector

## Vault Connector [entity-storage, hashicorp]
PLAYGROUND_VAULT_CONNECTOR="entity-storage"

# Background Task Connector

## Background Task Connector [entity-storage]
PLAYGROUND_BACKGROUND_TASK_CONNECTOR="entity-storage"

# Event Bus Connector

## Event Bus Connector [local]
PLAYGROUND_EVENT_BUS_CONNECTOR="local"

# Telemetry Connector

## Telemetry Connector [entity-storage]
PLAYGROUND_TELEMETRY_CONNECTOR="entity-storage"

# Faucet Connector

## Faucet Connector Connector [entity-storage, iota]
PLAYGROUND_FAUCET_CONNECTOR="entity-storage"

# Wallet Connector

## Wallet Connector Connector [entity-storage, iota]
PLAYGROUND_WALLET_CONNECTOR="entity-storage"

# Verifiable Storage Connector

## Verifiable Storage Connector [entity-storage, iota]
PLAYGROUND_VERIFIABLE_STORAGE_CONNECTOR="entity-storage"

# NFT Connector

## NFT Connector [entity-storage, iota]
PLAYGROUND_NFT_CONNECTOR="entity-storage"

# Identity Resolver Connector

## Identity Resolver Connector [entity-storage, iota, universal]
PLAYGROUND_IDENTITY_RESOLVER_CONNECTOR="entity-storage"

## Endpoint for universal resolver
# PLAYGROUND_UNIVERSAL_RESOLVER_ENDPOINT=""

# Identity Connector

## Identity Connector [entity-storage, iota]
PLAYGROUND_IDENTITY_CONNECTOR="entity-storage"

# Identity Profile Connector

## Identity Profile Connector [entity-storage]
PLAYGROUND_IDENTITY_PROFILE_CONNECTOR="entity-storage"

# Immutable Proof

## The assertion method from the identity to use in immutable proof operations
# PLAYGROUND_IMMUTABLE_PROOF_ASSERTION_METHOD_ID="immutable-proof-assertion"

# Attestation

## Attestation Connector Connector [nft]
PLAYGROUND_ATTESTATION_CONNECTOR="nft"

## The attestation assertion method to use from the DID
# PLAYGROUND_ATTESTATION_ASSERTION_METHOD_ID="attestation-assertion"

# Auth Processor

## Auth Admin Type [entity-storage]
PLAYGROUND_AUTH_ADMIN_PROCESSOR_TYPE="entity-storage"

## Auth Type [entity-storage]
PLAYGROUND_AUTH_PROCESSOR_TYPE="entity-storage"

## The key to use for signing in auth operations
# PLAYGROUND_AUTH_SIGNING_KEY_ID="auth-signing"

# Messaging

## Messaging Email Connector Connector [entity-storage, aws]
PLAYGROUND_MESSAGING_EMAIL_CONNECTOR="entity-storage"

## Messaging SMS Connector Connector [entity-storage, aws]
PLAYGROUND_MESSAGING_SMS_CONNECTOR="entity-storage"

## Messaging Push Notifications Connector Connector [entity-storage, aws]
PLAYGROUND_MESSAGING_PUSH_NOTIFICATIONS_CONNECTOR="entity-storage"

## The AWS Application for push notifications JSON string version of IAwsApplicationSettings array
# PLAYGROUND_AWS_MESSAGING_PUSH_NOTIFICATION_APPLICATIONS="[]"

# Data Processing

## Data Converters [json,xml]
PLAYGROUND_DATA_CONVERTER_CONNECTORS="json,xml"

## Data Extractors [json-path]
PLAYGROUND_DATA_EXTRACTOR_CONNECTORS="json-path"

# Synchronised Storage

# PLAYGROUND_SYNCHRONISED_STORAGE_ENABLED="false"

## If this is not a trusted node we need to point the synchronised storage service to a node that can support trusted storage
# PLAYGROUND_SYNCHRONISED_STORAGE_TRUSTED_URL=""

## If you want to use a custom verifiable storage key ID for synchronised storage you can supply an id here
## The default is to use the network name and the inbuilt verifiable storage ids.
# PLAYGROUND_SYNCHRONISED_STORAGE_VERIFIABLE_STORAGE_KEY_ID=""

## The identity verification method id to use with synchronised storage for signing/verifying changesets.
# PLAYGROUND_SYNCHRONISED_STORAGE_VERIFICATION_METHOD_ID="synchronised-storage-assertion"

## The key from the vault which is used to encrypt the synchronised storage blobs.
## Only required for trusted nodes, as regular nodes will request from the trusted nodes.
# PLAYGROUND_SYNCHRONISED_STORAGE_BLOB_STORAGE_ENCRYPTION_KEY_ID="synchronised-storage-blob-encryption-key"

## The private key used for blob encryption in synchronised storage ChaCha20Poly1305 in base64 format.
## Only required for trusted nodes, as regular nodes will not write encrypted data.
# PLAYGROUND_SYNCHRONISED_STORAGE_BLOB_STORAGE_KEY=""

## How often to check for entity updates in minutes.
# PLAYGROUND_SYNCHRONISED_STORAGE_ENTITY_UPDATE_INTERVAL_MINUTES="5"

## Interval to perform consolidation of changesets, only used if this is a trusted node.
# PLAYGROUND_SYNCHRONISED_STORAGE_CONSOLIDATION_INTERVAL_MINUTES="60"

## The number of entities to process in a single consolidation batch, only used if this is a trusted node.
# PLAYGROUND_SYNCHRONISED_STORAGE_CONSOLIDATION_BATCH_SIZE="1000"

## The maximum number of consolidations to keep in storage, only used if this is a trusted node.
# PLAYGROUND_SYNCHRONISED_STORAGE_MAX_CONSOLIDATIONS="5"

# Federated Catalog

# PLAYGROUND_FEDERATED_CATALOG_ENABLED="false"

## Federated catalog TTL for the cache in ms
# PLAYGROUND_FEDERATED_CATALOG_CACHE_TTL_MS="60000"

## Federated catalog clearing house approver list, stringified array of DIDs.
# PLAYGROUND_FEDERATED_CATALOG_CLEARING_HOUSE_APPROVER_LIST="[]"

## Rights Management
# PLAYGROUND_RIGHTS_MANAGEMENT_ENABLED="false"

## What is the base callback url for rights management negotiations e.g. https://my-node/rights-management.
# PLAYGROUND_RIGHTS_MANAGEMENT_BASE_CALLBACK_URL="https://my-node/rights-management"

## Information source modules - use the @json: prefix to specify the path to the JSON file.
# PLAYGROUND_RIGHTS_MANAGEMENT_INFORMATION_SOURCES="@json:rights-management-information-sources.json"

## Negotiator modules - use the @json: prefix to specify the path to the JSON file.
# PLAYGROUND_RIGHTS_MANAGEMENT_NEGOTIATORS="@json:rights-management-negotiators.json"

## Requester modules - use the @json: prefix to specify the path to the JSON file.
# PLAYGROUND_RIGHTS_MANAGEMENT_REQUESTERS="@json:rights-management-requesters.json"

## Execution action modules - use the @json: prefix to specify the path to the JSON file.
# PLAYGROUND_RIGHTS_MANAGEMENT_EXECUTION_ACTIONS="@json:rights-management-execution-actions.json"

## Enforcement processor modules - use the @json: prefix to specify the path to the JSON file.
# PLAYGROUND_RIGHTS_MANAGEMENT_ENFORCEMENT_PROCESSORS="@json:rights-management-enforcement-processors.json"

## Enforcement arbiter modules - use the @json: prefix to specify the path to the JSON file.
# PLAYGROUND_RIGHTS_MANAGEMENT_ARBITERS="@json:rights-management-arbiters.json"

## Enforcement offers - use the @json: prefix to specify the path to the JSON file.
# PLAYGROUND_RIGHTS_MANAGEMENT_OFFERS="@json:rights-management-offers.json"

## Task Scheduler
PLAYGROUND_TASK_SCHEDULER_ENABLED="true"

## Data Space Connector
# PLAYGROUND_DATA_SPACE_CONNECTOR_ENABLED="false"

## Data Space Apps Config file - use the @json: prefix to specify the path to the JSON file.
# PLAYGROUND_DATA_SPACE_CONNECTOR_APPS="@json:apps.json"

## Node to Node Communication

## Verifiable credential assertion for node to node communication.
# PLAYGROUND_AUTHENTICATION_VERIFICATION_METHOD_ID="node-authentication-assertion"

## Enable the route processors for verifiable credentials.
# PLAYGROUND_ENABLE_VERIFIABLE_CREDENTIAL_ROUTE_PROCESSORS="true"