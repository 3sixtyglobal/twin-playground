{
	"name": "@twin.org/playground-node",
	"version": "0.0.3-next.0",
	"description": "Serve APIs using the specified configuration",
	"private": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/twinfoundation/playground.git",
		"directory": "apps/playground-node"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "tspc",
		"dev": "concurrently \"tspc --watch\" \"nodemon\"",
		"merge-locales": "merge-locales",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "validate-locales",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"docs:clean": "rimraf docs/open-api",
		"docs:api": "ts-to-openapi ./ts-to-openapi.json ./docs/open-api/spec.json",
		"docs": "npm run docs:clean && npm run docs:api",
		"dist": "npm run clean && npm run build && npm run merge-locales && npm run validate-locales && npm run test:build && npm run test",
		"dist:no-test": "npm run clean && npm run build && npm run merge-locales",
		"start": "node dist/es/index.js"
	},
	"dependencies": {
		"@twin.org/context": "next",
		"@twin.org/core": "next",
		"@twin.org/engine": "next",
		"@twin.org/engine-models": "next",
		"@twin.org/engine-types": "next",
		"@twin.org/node-core": "next",
		"@twin.org/entity": "next"
	},
	"devDependencies": {
		"@twin.org/entity-storage-connector-memory": "next",
		"@twin.org/merge-locales": "next",
		"@twin.org/nameof-transformer": "next",
		"@twin.org/nameof-vitest-plugin": "next",
		"@twin.org/validate-locales": "next",
		"@twin.org/ts-to-openapi": "next",
		"@types/node": "25.3.3",
		"@vitest/coverage-v8": "4.0.18",
		"concurrently": "9.2.1",
		"copyfiles": "2.4.1",
		"cross-env": "10.1.0",
		"nodemon": "3.1.14",
		"rimraf": "6.1.3",
		"ts-patch": "3.3.0",
		"typedoc": "0.28.17",
		"typedoc-plugin-markdown": "4.10.0",
		"typescript": "5.9.3",
		"vitest": "4.0.18"
	},
	"bugs": {
		"url": "git+https://github.com/twinfoundation/playground/issues"
	},
	"homepage": "https://twindev.org"
}
